{
  "name": "emanowa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "日本語のオンライン絵馬サービス「えまのわ」",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:local-role": "node scripts/setup-local-db-role.mjs",
    "test:db": "bash scripts/test-local-db.sh",
    "test:stage-b": "supabase db reset --local && bash scripts/test-local-db.sh && node scripts/stage-b-integration.mjs",
    "test:stage-c": "supabase db reset --local && bash scripts/test-local-db.sh && node scripts/stage-b-integration.mjs && node scripts/stage-c-integration.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:clear": "node scripts/demo-clear.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
