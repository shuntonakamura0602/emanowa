# Runtime classification. Defaults to development when blank.
# Set production explicitly in the public environment; demo is then rejected.
EMANOWA_ENVIRONMENT=
EMANOWA_DATA_MODE=

# Public: Supabase Auth connection details. These values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: canonical origin and the restricted application database role.
APP_ORIGIN=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Server-only feature gates. Blank means false; keep all three false for P0.
ENABLE_GROUPS=
ENABLE_FULFILLMENT=
ENABLE_PAYMENTS=

# Server-owned world selection. Blank uses the configured 2027 world.
FEATURED_WORLD_SLUG=

# Abuse prevention. Only the site key may be exposed to the browser.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=

# Public operational information. Required before production publication.
OPERATOR_NAME=
CONTACT_URL=
