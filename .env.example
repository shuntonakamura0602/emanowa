# Runtime classification. Defaults to development when blank.
# Set production explicitly in the public environment; demo is then rejected.
EMANOWA_ENVIRONMENT=
EMANOWA_DATA_MODE=

# Public: Supabase Auth connection details. Use a bare HTTPS origin in
# staging/production (local development may use a bare HTTP origin). The key
# must be a publishable/anon key, never sb_secret_ or a service-role JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: canonical origin and database connections. APP_ORIGIN must be a
# bare HTTPS origin in staging/production; do not include credentials or paths.
APP_ORIGIN=
# Normal API traffic only. Use the complete emanowa_app transaction-pooler URL
# with username, password, host, port, database, and remote sslmode explicit;
# owner, postgres, service_role, and BYPASSRLS credentials are rejected.
DATABASE_URL=
# Moderation API only. Use the separate complete emanowa_admin_app URL; never
# expose it to browser code or reuse it for ordinary posting and public reads.
ADMIN_DATABASE_URL=

# Server-only feature gates. Blank means false; keep all three false for P0.
ENABLE_GROUPS=
ENABLE_FULFILLMENT=
ENABLE_PAYMENTS=

# Server-owned world selection. Blank uses the configured 2027 world.
FEATURED_WORLD_SLUG=

# Abuse prevention. The P0 client uses Cloudflare Turnstile. Only the site key
# may be exposed to the browser. Configure the same secret in Supabase Auth;
# both values are required for anonymous sign-in/recovery in staging/production.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=
# Number of trusted reverse proxies that append X-Forwarded-For. Required in
# staging/production so image quotas cannot trust a client-spoofed address.
TRUSTED_PROXY_HOPS=

# Public operational information. Required in staging/production. Use the
# actual operator and an HTTPS contact page; do not commit real values here.
OPERATOR_NAME=
CONTACT_URL=

# Public policy copy. Enter the effective date and concrete retention notices
# that match the selected host, backups, logs, and deletion procedure. Do not
# use placeholders or promise immediate removal from third-party caches.
POLICY_EFFECTIVE_DATE=
CONTENT_RETENTION_NOTICE=
BACKUP_RETENTION_NOTICE=
LOG_RETENTION_NOTICE=

# Server-owned publication gate. Only set true in production after the actual
# domain, world schedule, operator, policy copy, and operating procedure have
# been reviewed. Staging readiness does not require approval.
PUBLICATION_APPROVED=
