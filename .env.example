# Runtime classification. Defaults to development when blank.
# Set production explicitly in the public environment; demo is then rejected.
EMANOWA_ENVIRONMENT=
EMANOWA_DATA_MODE=

# Public: Supabase Auth connection details. These values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: canonical origin and database connections.
APP_ORIGIN=
# Normal API traffic only. Use the emanowa_app transaction-pooler URL;
# owner, postgres, service_role, and BYPASSRLS credentials are rejected.
DATABASE_URL=
# Migration/backup connection only. Never expose it to browser code or use it in normal API traffic.
MIGRATION_DATABASE_URL=

# Server-only feature gates. Blank means false; keep all three false for P0.
ENABLE_GROUPS=
ENABLE_FULFILLMENT=
ENABLE_PAYMENTS=

# Server-owned world selection. Blank uses the configured 2027 world.
FEATURED_WORLD_SLUG=

# Abuse prevention. The P0 client uses Cloudflare Turnstile. Only the site key
# may be exposed to the browser. Configure the same secret in Supabase Auth;
# both values are required for anonymous sign-in/recovery in staging/production.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=

# Public operational information. Required before production publication.
OPERATOR_NAME=
CONTACT_URL=
